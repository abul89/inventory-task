APP_NAME="Store Billing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite works out of the box. For MySQL change these 6 lines.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=store_orders
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file

# Queued jobs are stored in the "jobs" table. Run: php artisan queue:work
QUEUE_CONNECTION=database

# Fake mailer: mails are written to storage/logs/laravel.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="billing@store.test"
MAIL_FROM_NAME="${APP_NAME}"

# Products with stock BELOW this number are "low stock"
LOW_STOCK_THRESHOLD=10
