APP_NAME="Store Billing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# pgsql
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=store_orders
DB_USERNAME=postgres
DB_PASSWORD=admin@123

SESSION_DRIVER=file
CACHE_STORE=file

# Queued jobs are stored in the "jobs" table. Run: php artisan queue:work
QUEUE_CONNECTION=database

# Fake mailer: mails are written to storage/logs/laravel.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="billing@store.test"
MAIL_FROM_NAME="${APP_NAME}"

# Products with stock BELOW this number are "low stock"
LOW_STOCK_THRESHOLD=10
